# ClaimGuard AI local configuration
# Copy this file to .env for local development and fill in real values.
# Never commit .env or real secrets.

APP_NAME=ClaimGuard AI
APP_ENV=local

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# SQLite is the local default. Replace with PostgreSQL later if needed.
DATABASE_URL=sqlite:///data/claimguard.db

MAX_UPLOAD_SIZE_MB=10
OCR_ENABLED=true
OCR_LANGUAGES=en
MAX_PDF_PAGES=50
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_IMAGE_PIXELS=25000000
LOG_LEVEL=INFO

FRAUD_MODEL_PATH=models/fraud_model.joblib
TRAINING_DATA_PATH=data/raw/fraud_oracle.csv
VECTOR_INDEX_PATH=vector_store/policy.index
VECTOR_METADATA_PATH=vector_store/policy_chunks.json
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Streamlit frontend only
CLAIMGUARD_API_URL=http://localhost:8000
